# Copiá este archivo como .env.local (en tu compu) y cargá las mismas variables en Vercel.
# Las marcadas OBLIGATORIA son necesarias para cobrar con Mercado Pago (además de las credenciales, que el
# dueño carga en el panel: Ajustes → Mercado Pago). Si falta algo, la tienda sigue andando y se compra con
# «Copiar pedido» / «DM», y el panel lo avisa en Ajustes → Estado de la tienda.

# OBLIGATORIA. URL final del sitio (https, sin barra al final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tipificado.vercel.app

# OBLIGATORIAS. Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡SECRETA! Solo en el servidor (Vercel). Nunca la pegues en el código.
SUPABASE_SERVICE_ROLE_KEY=

# Clave del servidor para guardar CIFRADAS las credenciales de Mercado Pago que el dueño carga en
# el panel (Ajustes → Mercado Pago). 32 bytes en base64. Se genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ¡SECRETA! Va SOLO en Vercel (Production). No la pongas acá ni en GitHub, ni la mandes por chat.
# Si la cambiás, hay que volver a cargar las credenciales en el panel. Ver README → «Mercado Pago desde el panel».
# CREDENCIALES_KEY=

# RESPALDO (opcional desde que existe el panel). Si en Ajustes → Mercado Pago no hay nada cargado, se usan estas.
# Mercado Pago → Tus integraciones → tu aplicación → Credenciales de producción (cuenta del CLIENTE; APP_USR-…)
MP_ACCESS_TOKEN=
# Mercado Pago → tu aplicación → Webhooks → Clave secreta
MP_WEBHOOK_SECRET=

# Opcional. El modo prueba se prende y apaga en Ajustes → Mercado Pago. Si esta variable existe, GANA sobre
# el panel (MP_MODO=prueba lo fuerza encendido; cualquier otro valor, apagado). En producción, NO la pongas.
# MP_MODO=prueba

# Opcional: mail al dueño cada vez que un pedido pasa a «Pagado» (resend.com)
RESEND_API_KEY=
# A quién le llega (podés poner varios separados por coma)
MAIL_DUENO=
# Remitente (con un dominio verificado en Resend). Si no lo ponés, sale de onboarding@resend.dev,
# que solo puede mandar al mail con el que creaste la cuenta de Resend.
# MAIL_DESDE=tipificado <avisos@tipificado.com.ar>

# Opcional: quitar fondo automático desde el panel (remove.bg)
REMOVE_BG_API_KEY=

# Opcional: cálculo automático del envío por Andreani (cotiza con Zipnova; el envío real lo despachás vos a mano).
# Sin estas 4, la tienda usa la tabla de respaldo por provincia o «Envío a coordinar». Zipnova → tu cuenta → API.
# ¡SECRETAS! Solo en .env.local y en Vercel. Nunca las pegues en el código ni en GitHub (el repo es público).
ZIPNOVA_KEY=
ZIPNOVA_SECRET=
ZIPNOVA_ACCOUNT_ID=
ZIPNOVA_ORIGIN_ID=

# Opcional: con esto, solo el cron de Vercel puede llamar a /api/cron/stock (libera reservas vencidas)
CRON_SECRET=
